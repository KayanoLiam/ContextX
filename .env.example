# 上流APIキーはサーバー環境だけに保存し、実際の値をコミットしないでください。
GROK_API_KEY=replace-with-your-key

# OpenAI互換のResponses APIエンドポイントです。実際の上流URLに置き換えてください。
GROK_UPSTREAM_URL=https://your-upstream.example/v1/responses

# サーバーの待受アドレスです。
BIND_ADDR=0.0.0.0:3000

# 許可するHostをカンマ区切りで指定します。本番環境では実際のドメインを追加してください。
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,mcp.twitter.monster
